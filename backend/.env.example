# Mini Plane 后端环境变量样例。
# 使用方式：复制本文件为 .env 并填入真实值；.env 已被 .gitignore 排除，禁止提交。
SECRET_KEY=change-me

DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL 连接串（Sprint 0 建库命令见 BACKEND_PLAN 附录 A）
DATABASE_URL=postgres://postgres:YOUR_PG_PASSWORD@127.0.0.1:5432/miniplane

# Sprint 1 前端联调时使用（Next.js 本地端口）
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# ── Sprint 6：缓存与异步任务 ─────────────────────────────────
# 不配 CACHE_URL → LocMem（单进程内存缓存），本地最省事
# 配了就走 Redis（先 `docker compose up -d redis`），缓存语义不变、只是能跨进程共享
# CACHE_URL=redis://127.0.0.1:6379/0

# Celery broker / 结果后端（默认 Redis）
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# 本地是否"同步执行任务"（True=不需要 worker/Redis，默认 True，见 config/settings/local.py）
# 想验证真 worker 消费：设为 False，再 `python -m celery -A config worker -l info`
CELERY_TASK_ALWAYS_EAGER=True
# 没有 Docker 时的备选通道（跨进程可用，不需要 Redis）：
# CELERY_BROKER_URL=filesystem://
