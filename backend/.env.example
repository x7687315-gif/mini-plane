# Mini Plane 后端环境变量样例。
# 使用方式：复制本文件为 .env 并填入真实值；.env 已被 .gitignore 排除，禁止提交。
SECRET_KEY=change-me

DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL 连接串（Sprint 0 建库命令见 BACKEND_PLAN 附录 A）
DATABASE_URL=postgres://postgres:YOUR_PG_PASSWORD@127.0.0.1:5432/miniplane

# Sprint 1 前端联调时使用（Next.js 本地端口）
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
